{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "build",
  "share": "disabled",
  "formatter": true,
  "lsp": true,
  "snapshot": true,
  "autoupdate": "notify",
  "instructions": [
    "AGENTS.md",
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
    "tail_turns": 4
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "out/**",
      ".next/**",
      ".nuxt/**",
      "coverage/**",
      ".turbo/**",
      ".cache/**",
      ".pytest_cache/**",
      "__pycache__/**",
      ".venv/**",
      "venv/**",
      "target/**",
      "tmp/**",
      "logs/**",
      "*.log"
    ]
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "tr": "allow",
      "tr *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "diff": "allow",
      "diff *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "sed": "allow",
      "sed *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git grep*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "ask",
      "rm *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "todowrite": "allow",
    "skill": "allow"
  },
  "tool_output": {
    "max_bytes": 30000,
    "max_lines": 1000
  },
  "provider": {
    "opencode-go": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    },
    "zai-coding-plan": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "description": "Default primary agent for development work: writing, editing, and refactoring code across the codebase. Use when the user asks to implement, fix, build, scaffold, or modify code. Has full tool access and can delegate to specialist subagents.",
      "permission": {
        "edit": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
          "go build*": "allow",
          "go test*": "allow"
        }
      }
    },
    "plan": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "high",
      "mode": "primary",
      "description": "Primary agent for planning and analysis using Z.AI GLM-5.2 with high reasoning effort. Use when the user asks for a plan, design, architecture review, or exploration of approaches before making code changes. Does not edit files.",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "allow",
          "refactor": "deny",
          "test": "deny",
          "commit": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "general": {
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "subagent",
      "description": "General-purpose subagent for researching complex questions and running parallel multi-step units of work. Delegate to this agent when a task benefits from being run in the background or split into independent sub-tasks, and full tool access (including edits) is needed.",
      "permission": {
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "explore": {
      "description": "Fast, read-only subagent for exploring an unfamiliar codebase and answering research-oriented questions. Use to map project structure, find where something lives, search code for patterns, or locate files before making changes. Does not edit files.",
      "model": "zai-coding-plan/glm-5.2-highspeed",
      "mode": "subagent",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny"
      }
    },
    "review": {
      "description": "Subagent for code review, PR review, style checks, and feedback on code quality, security, or correctness using OpenAI GPT-5.6 Sol. Call when the user asks for a review, wants feedback on a diff or PR, or uses @review. Read-only; does not edit.",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    },
    "debug": {
      "description": "Subagent for diagnosing bugs, errors, crashes, and unexpected behavior using OpenAI GPT-5.6 Sol. Call when the user reports a bug, error, crash, stack trace, failing test, or unexpected output. Reproduces issues and reads stack traces to find root causes. Read-only; does not fix code.",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny"
      }
    },
    "refactor": {
      "description": "Subagent for restructuring, renaming, extracting, and modernizing existing code using Kimi K2.7 Code. Call when the user asks to refactor, reduce duplication, extract a function or module, rename symbols, or apply design patterns. Improves code organization without adding features. Can edit files.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent",
      "permission": {
        "edit": "allow"
      }
    },
    "test": {
      "description": "Subagent for writing, fixing, and analyzing unit and integration tests using Kimi K2.7 Code. Call when the user asks to write tests, fix a failing test suite, build a test plan, or design mocking strategies. Can edit files.",
      "model": "opencode-go/kimi-k2.7-code",
      "mode": "subagent",
      "permission": {
        "edit": "allow"
      }
    },
    "explain": {
      "description": "Subagent for explaining code, walking through files, functions, and algorithms, and answering 'what does this do?' or 'how does this work?' questions using Z.AI GLM-5.2 Highspeed. Read-only; does not modify code.",
      "model": "zai-coding-plan/glm-5.2-highspeed",
      "mode": "subagent",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny"
      }
    },
    "commit": {
      "description": "Subagent for creating git commits. Call when the user asks to commit, stage and commit, or create a git commit. Drafts conventional commit messages, stages unstaged files when needed, and splits changes into logical commits.",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add*": "allow",
          "git restore*": "allow",
          "git reset*": "allow",
          "git commit*": "allow"
        }
      }
    },
    "scout": {
      "description": "Subagent for external documentation and dependency research using Z.AI GLM-5.2 Highspeed. Call when the user asks to look up library docs, read an upstream dependency README/source, check API references, or research how a third-party package works. Read-only; does not modify the workspace.",
      "model": "zai-coding-plan/glm-5.2-highspeed",
      "mode": "subagent",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow",
        "edit": "deny"
      }
    },
    "security": {
      "description": "Subagent for performing security audits and identifying vulnerabilities using OpenAI GPT-5.6 Sol. Call when the user asks for a security review, to find vulnerabilities, check input validation, authentication/authorization flaws, data exposure, or dependency CVEs. Read-only; does not edit.",
      "model": "openai/gpt-5.6-sol",
      "mode": "subagent",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny"
      }
    }
  }
}