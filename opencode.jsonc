{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "opencode-go/glm-5.3-flash",
  "default_agent": "plan",
  "share": "disabled",
  "formatter": true,
  "lsp": true,
  "snapshot": true,
  "autoupdate": "notify",
  "instructions": [
    "AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
    "tail_turns": 4
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "out/**",
      ".next/**",
      ".nuxt/**",
      "coverage/**",
      ".turbo/**",
      ".cache/**",
      ".pytest_cache/**",
      "__pycache__/**",
      ".venv/**",
      "venv/**",
      "target/**",
      "tmp/**",
      "logs/**",
      "*.log"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "ask",
      "rm *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "supabase db reset*": "ask",
      "supabase db push*": "ask",
      "supabase migrations repair*": "ask",
      "supabase start*": "ask",
      "supabase stop*": "ask",
      "docker run*": "ask",
      "docker exec*": "ask",
      "docker start*": "ask",
      "docker stop*": "ask",
      "docker restart*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker system prune*": "ask",
      "docker container prune*": "ask",
      "docker image prune*": "ask",
      "docker volume rm*": "ask",
      "docker volume prune*": "ask",
      "docker network rm*": "ask",
      "docker network prune*": "ask",
      "docker compose up*": "ask",
      "docker compose down*": "ask",
      "docker compose start*": "ask",
      "docker compose stop*": "ask",
      "docker compose restart*": "ask",
      "docker compose run*": "ask",
      "docker compose exec*": "ask",
      "docker compose rm*": "ask"
    },
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "skill": "allow"
  },
  "provider": {
    "opencode-go": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "enabled_providers": [
    "openai",
    "opencode-go"
  ],
  "agent": {
    "plan": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "title": {
      "prompt": "Generate a short session title from this conversation. Use at most 3-4 words, no prefix, no quotes, and no punctuation. Output only the title text."
    }
  }
}
