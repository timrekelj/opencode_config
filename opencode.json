{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-claude-auth@latest",
    "/Users/timrekelj/.config/opencode/plugins/github",
    "/Users/timrekelj/.config/opencode/plugins/usage-view",
    "/Users/timrekelj/.config/opencode/plugins/x-view"
  ],
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      }
    }
  },
  "default_agent": "build",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "pitcrew-*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree *", "effect": "allow" },
    { "action": "shell", "resource": "git cherry *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "npm run test *", "effect": "allow" },
    { "action": "shell", "resource": "npm run check *", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck *", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go build *", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "go fmt *", "effect": "allow" },
    { "action": "shell", "resource": "supabase status *", "effect": "allow" },
    { "action": "shell", "resource": "supabase start *", "effect": "allow" },
    { "action": "shell", "resource": "supabase stop *", "effect": "allow" },
    { "action": "shell", "resource": "supabase db reset *", "effect": "allow" },
    { "action": "shell", "resource": "psql *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "xcrun simctl *", "effect": "allow" },
    { "action": "shell", "resource": "maestro test *", "effect": "allow" },
    { "action": "shell", "resource": "npx expo *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "supabase db push *", "effect": "ask" },
    { "action": "shell", "resource": "supabase db reset", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" }
  ],
  "formatter": true,
  "worktree": {
    "directory": "../worktrees"
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "experimental": {
    "todo": true,
    "background_compaction": true
  }
}
