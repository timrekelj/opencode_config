{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "/Users/timrekelj/.config/opencode/plugins/github",
    "/Users/timrekelj/.config/opencode/plugins/devices",
    "/Users/timrekelj/.config/opencode/plugins/side-chat",
    {
      "package": "/Users/timrekelj/.config/opencode/plugins/usage-view",
      "options": {
        "aliases": {
          "claude-agent/opus": "claude-opus-5-5",
          "claude-agent/sonnet": "claude-sonnet-5-5",
          "claude-agent/haiku": "claude-haiku-5-5",
          "claude-agent/fable": "claude-fable-5-1"
        }
      }
    }
  ],
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "heroui-react": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@heroui/react-mcp@latest"
        ]
      }
    }
  },
  "default_agent": "build",
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "ask" },
    { "action": "skill", "resource": "work", "effect": "allow" },
    { "action": "skill", "resource": "verify", "effect": "allow" },
    { "action": "skill", "resource": "ship", "effect": "allow" },
    { "action": "skill", "resource": "branches", "effect": "allow" },
    { "action": "skill", "resource": "browser", "effect": "allow" },
    { "action": "skill", "resource": "agent-desktop*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "supabase db push *", "effect": "ask" },
    { "action": "shell", "resource": "supabase db reset *", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop *", "effect": "ask" },
    { "action": "shell", "resource": "agent-desktop snapshot *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop find *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop get *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop is *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop wait *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop list-apps *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop list-windows *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop list-displays *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop list-surfaces *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop status *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop version *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop skills *", "effect": "allow" },
    { "action": "shell", "resource": "agent-desktop * --help", "effect": "allow" }
  ],
  "formatter": true,
  "worktree": {
    "directory": "../worktrees"
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "experimental": {
    "todo": true,
    "background_compaction": true
  }
}
