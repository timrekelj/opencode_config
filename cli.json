{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "compact"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  }
}
